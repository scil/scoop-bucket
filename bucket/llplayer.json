{
    "version": "0.3.0",
    "description": "Media player for language learning, with dual subtitles, AI-generated subtitles, real-time translation, and more",
    "homepage": "https://github.com/umlx5h/LLPlayer",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/umlx5h/LLPlayer/releases/download/v0.3.0/LLPlayer-v0.3.0-x64.7z",
            "hash": "21761979f4e335b7ec42fcf813707f68e18ea97b5baa6676061e4a5569297f6b"
        }
    },
    "post_install": [
        "# Config files are restored by copy instead of 'persist': LLPlayer uses built-in defaults only when a file is absent,",
        "# so scoop's placeholder (a directory) or an empty seed file would break it",
        "'LLPlayer.Config.json', 'LLPlayer.PlayerConfig.json', 'LLPlayer.Engine.json' | ForEach-Object {",
        "    if (Test-Path \"$persist_dir\\$_\" -PathType Leaf) { Copy-Item \"$persist_dir\\$_\" \"$dir\\$_\" -Force }",
        "}"
    ],
    "pre_uninstall": [
        "New-Item $persist_dir -ItemType Directory -Force | Out-Null",
        "'LLPlayer.Config.json', 'LLPlayer.PlayerConfig.json', 'LLPlayer.Engine.json' | ForEach-Object {",
        "    # Mirror deletions too, so a config removed to reset LLPlayer isn't restored from a stale copy",
        "    if (Test-Path \"$dir\\$_\" -PathType Leaf) { Copy-Item \"$dir\\$_\" \"$persist_dir\\$_\" -Force }",
        "    else { Remove-Item \"$persist_dir\\$_\" -Force -ErrorAction SilentlyContinue }",
        "}"
    ],
    "shortcuts": [
        [
            "LLPlayer.exe",
            "LLPlayer"
        ]
    ],
    "checkver": {
        "github": "https://github.com/umlx5h/LLPlayer"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/umlx5h/LLPlayer/releases/download/v$version/LLPlayer-v$version-x64.7z"
            }
        }
    },
    "notes": [
        "LLPlayer requires .NET Desktop Runtime 10 (scoop install extras/windowsdesktop-runtime).",
        "Settings files are copied to $persist_dir on update/uninstall and restored on install."
    ]
}
